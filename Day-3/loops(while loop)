write a program to print series of multiplication table within the range from n1 to n2 
#include <stdio.h>

int main() {
    int n1, n2;

    printf("Enter starting number (n1): ");
    scanf("%d", &n1);

    printf("Enter ending number (n2): ");
    scanf("%d", &n2);

    int i = 1;  // row (1 to 10)

    while(i <= 10) {
        int j = n1;  // tables from n1 to n2

        while(j <= n2) {
            printf("%d x %d = %-3d\t", j, i, j * i);
            j++;
        }

        printf("\n");
        i++;
    }

    return 0;
}
