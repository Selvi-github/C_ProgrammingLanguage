goto is a keyword which requires the label , goto statement should end with a ; label statement should end with :.

eg;
// Online C compiler to run C program online
#include <stdio.h>

int main() {
      goto down;
      printf("A");
      printf("B");
      down:
      printf("C");
    return 0;
}
output:
C

