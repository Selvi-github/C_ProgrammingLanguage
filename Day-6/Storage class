9. extern Storage Class
extern variables are global variables accessible across the entire program and all functions.
Basic Global Access
cint pct;        // def / 0 / extern
void ECE() {
    ++pct;
}
void EEE() {
    ++pct;
}
void CSE() {
    ++pct;
}
void main() {
    ++pct;
    ece(); eee(); cse();
    printf("%d", pct);
}

extern Across Files
When a global variable is defined in one file and used in another, use extern keyword:
c// File 1:
int pct;         // definition
void ECE() { ++pct; }

// File 2:
extern int pct;  // declaration (no memory allocation, just reference)
void EEE() { ++pct; }
CE occurs when:
cvoid ECE() {
    extern int pct;
    ++pct;         // CE: pct not defined globally yet
}
Fix — define globally:
cvoid ECE() {
    extern int RT;
    ++RT;
}
void ECE() {
    extern int RT;
    ++RT;
}
void main() {
    extern int pct;
    ++pct; ECE(); EEE();
    printf("%d", pct);  // int pct; at end → CE
}
int pct;  // definition must exist somewhere

Static Function with Decreasing Counter
c#include <stdio.h>
int fun() {
    static int num = 16;
    return num--;
}

int main() {
    for(fun(); fun(); fun())
        printf("%d ", fun());
    return 0;
}
// O/P: 14  11  8  5
