5. Character Data Type (char)
Signed Char
DT  : char | signed char | char signed
Size: 8 bits
Range: -128 to 127
FS  : %c
Ex  : 'a', 'A', '+', '5', '-', 'x', ' '
Examples
c// 1. signed char
void main() {
    signed char ch;
    ch = 'A';
    printf("%c", ch);    // A
    printf("%d", ch);    // 65
}

// 2. char with integer
void main() {
    char ch;
    ch = 65;
    printf("%c %d", ch, ch);   // A  65
    // 65 → 'A'
}

// 3. Mixing %c and %d
printf("%c %d", 'A', 'A');     // A  65

// 4.
printf("%c", 65);               // A

Overflow Behavior
c// 5. char ch
void main() {
    char ch;
    ch = 100-92;
    printf("%c %d", ch, ch);   // d  100 (approx)
}

// 6.
void main() {
    char ch;
    ch = 35;
    printf("%d", ch);    // 35
}
Overflow/Wraparound:
127 → 127 + 1 = 128 (overflow)
128 = 127 + 1
127 = 0111 1111
  1 = 0000 0001
      ─────────
128 = 1000 0000  → interpreted as -128 (signed)

129 → -127
130 → -126
131 → -125

Unsigned Char
DT  : unsigned char | char unsigned
Size: 8 bits
Range: 0 to 2⁸-1 = 255
FS  : %c
Ex  : '5', '1', '0', ' ', 'n', '5'
cvoid main() {
    unsigned char ch;
    ch = -1;
    printf("%d", ch);    // 255
}
Why 255?
-1 in binary (16-bit): 1111 1111 1111 1110
As unsigned 8-bit    : 1111 1111 = 255

6. Integer Data Types
Short int / short signed int / signed short int
Size : 16 bits
FS   : %d (or) %i
Range: -2¹⁵ to 2¹⁵-1  →  -32768 to 32767
Ex   : 5, 10, -25, 32760, -32764
cvoid main() {
    short int a;
    a = 32767+1;
    printf("%d", a);    // -32768  (overflow wraps around)
}

void main() {
    short int a;
    a = 1;
    while(a != 1) {
        printf("%d", a);
    }
    // O/P: -32767
}

Unsigned Short int
Size : 16 bits
Range: 0 to 2¹⁶-1  →  0 to 65535
FS   : %u
cvoid main() {
    unsigned short int u;
    u = -1;
    printf("%u", u);    // 65535
}

void main() {
    unsigned short u;
    for(u=5; u>=0; u--)
        printf("%u", u);
    // O/P: 5  4  3  2  1  0  65535 ...
}
16-bit Compiler output for -1:
-1      → FFFF (hex) → 65535 (unsigned)
-1      → 1111 1111 1111 1111
65535   → 1111 1111 1111 1111

