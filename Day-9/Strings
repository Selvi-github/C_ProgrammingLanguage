Strings
String Declaration
A string is an array of characters ending with null character '\0'
// Method 1: String literal
char str[] = "Hello";
// stored as: H e l l o \0

// Method 2: Character array
char str[] = {'H','e','l','l','o','\0'};

// Method 3: Pointer (not safely mutable)
char *str = "Hello";
Common String Functions
Function	Description
strlen(str)	Length (excluding '\0')
strcpy(a,b)	Copy b into a
strcat(a,b)	Concatenate b to a (stored in a)
strcmp(a,b)	Compare: 0 if equal, +ve if a>b, -ve if a<b
sizeof vs strlen
char str1[] = "zohoInterview";
int n1 = sizeof(str1)/sizeof(str1[0]);
// n1 = 14 (13 chars + '\0')

char str2[] = {'t','e','s','t','\0'};
int n2 = sizeof(str2)/sizeof(str2[0]);
// n2 = 9 (explicit chars)

printf("n1=%d n2=%d", n1, n2);
output
n1=14, n2=9
String Pointer Arithmetic
char str[] = "Aptitude";

// &str[5] → pointer from index 5
// str+5   → same, pointer arithmetic
// str[5]  → 't' (the character)

printf("%s %s\n", &str[5], str+5);
// "ude ude"

printf("%c %c\n", *(str+6), str[5]);
// 'd', 't'
output
ude ude d t
Palindrome Check (Number)
bool palindrome(int a) {
  int x = a, rev = 0;
  while (a >= 0) {
    rev = rev * 10 + (a % 10);
    a /= 10;
  }
  if (rev == x) return true;
  else return false;
}
