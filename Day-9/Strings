Pointers & Strings (Advanced)
Pointer to String (char**)
char *c[] = {"GeeksQuiz", "MCQ", "TEST", "QUIZ"};
char **cp = c;
int main() {
  printf("%s\n", *++cp);       // MCQ
  printf("%s\n", *--cp+3);      // sQuiz
  printf("%s\n", *cp[-2]+3);    // test
  printf("%s\n", cp[-1][-1]+1); // 9
  return 0;
}
output
TEST sQUIZ 9
Macro with Expression
#define SQR(x) (x*x)
int main() {
  int a, b = 3;
  a = SQR(b+2);
  // expands to: (b+2 * b+2)
  // = 3+2*3+2 = 3+6+2 = 11
  printf("%d", a);
}
output
11
Macros do text substitution — not evaluation! Use parentheses: #define SQR(x) ((x)*(x))
