Quick Rules:
1 & x = x      0 & x = 0
1 | x = 1      0 | x = x
1 ^ x = ~x     0 ^ x = x

9.5 Practical Bitwise Programs
Program 1 — Check Status of a Given Bit
cvoid main() {
    int data, bit;
    printf("Enter data and bit: ");
    scanf("%d %d", &data, &bit);
    if((data & (1 << bit)) == 0)
        printf("OFF");
    else
        printf("ON");
}
Example: data=5, bit=3
5    : 0000 0000 0000 0101
1<<3 : 0000 0000 0000 1000
AND  : 0000 0000 0000 0000  → OFF

Program 2 — Turn ON a Given Bit (without disturbing others)
cvoid main() {
    int data, bit;
    scanf("%d %d", &data, &bit);
    data = data | (1 << bit);
    printf("%d", data);
}
// data |= (1 << bit)

Program 3 — Turn OFF a Given Bit (without disturbing others)
cvoid main() {
    int data, bit;
    printf("Enter...");
    scanf("%d %d", &data, &bit);
    data = data & ~(1 << bit);
    // data & (32767 - bit)   equivalent
}

Program 4 — Toggle a Given Bit (without disturbing others)
cdata = data ^ (1 << bit);

Program 5 — Check if Number is Power of 2
cbool isPowerOfTwo(int n) {
    if(n & (n-1) == 0)
        return true;
    else
        return false;
}

// Better version:
if(n > 0 && (n & (n-1)) == 0)
    return true;
Powers of 2:
2⁰ = 1    → 0001
2¹ = 2    → 0010
2² = 4    → 0100
2³ = 8    → 1000
2⁴ = 16   → 10000

Program 6 — Count Number of 1 Bits (Hamming Weight)
cint hammingWeight(int n) {
    int onebit = 0;
    for(int bit = 0; bit < 32; bit++) {
        if((n & (1 << bit)) != 0)
            ++onebit;
    }
    return onebit;
}

bool isPowerOf3(int n) {
    int onebit = 0;
    if(n < 0) return false;
    for(int bit = 0; bit < 32; bit++) {
        if((n & (1 << bit)) != 0)
            ++onebit;
    }
    return (onebit == 1);
}

Program 7 — Bytes Swapping
Swap left byte to right byte and vice versa in given data 0xB774.
cvoid main() {
    int data;
    int data1, data2;
    data1 = data >> 8;    // 11111111 → 00000000  (right byte)
    data2 = data << 8;    // 0111 0100 0000 0000   (left byte)
    data = (data2) | (data1) & (0x00ff);
    // mask with 0x00ff to keep only lower byte of data1
}

Program 8 — Swap Even and Odd Bit Positions
cint data;
data = data ^ 1;   // swap last two bits (simplified)
return data;

// Full approach:
((n << 1) & (0xAAAA)) | ((n >> 1) & (0x5555))
