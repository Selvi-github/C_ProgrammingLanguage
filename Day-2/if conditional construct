Write a program to find the max of 2 integer display the result on the screen without using if condition 
// Online C compiler to run C program online
#include <stdio.h>
#include <stdlib.h>
int main() {
    int a,b,max;
     printf("Enter 2 number for the variable a,b\n");
     scanf("%d%d",&a,&b);
     max=(a+b+(abs(a-b)))/2;
    printf("max value is : %d",max);
    return 0;
}
