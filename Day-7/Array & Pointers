19. Array of Pointers
cint a[3];         // array of 3 integers
int *p[3];        // array of 3 integer pointers
int **pp[3];      // array of 3 pointers to integer pointers
Example
cint a, b, c;
int *p1, *p2, *p3;

a = 5; b = 2; c = 3;
p1 = &a; p2 = &b; p3 = &c;

// Array of pointers:
int *p[3];
p[0] = &a;     // p[0] → a
p[1] = &b;     // p[1] → b
p[2] = &c;     // p[2] → c

// Accessing:
*p[0] → 5
*p[1] → 2
*p[2] → 3

// Swapping via array of pointers:
int *p1 = &a;
p1 = &a+1;      // p1 = a+1 = ptr arithmetic
p3 = &a+2;

int a[3] = {10, 20, 30};
int *p1 = a;           // p1 = &a[0]
int *p2 = &a[1];       // p2 = &a[1]
int *p3 = &a[2];       // p3 = &a[2]

p[0] = a+1;    // p[0] points to a[1]
p[1] = a;      // p[1] points to a[0]
p[2] = a+2;    // p[2] points to a[2]

// Then:
// p[0][0] == *(p[0]+0) == a[1] == 20
// p[1][0] == a[0] == 10
// p[2][0] == a[2] == 30

