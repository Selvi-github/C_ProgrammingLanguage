7. Pointer Examples
Basic Pointer Example
cint a;
a = 5;
int *ip;
ip = &a;         // ip points to a

printf("%d", a);     // 5     (value of a)
printf("%d", &a);    // 500   (address — int type)
printf("%d", ip);    // 500   (int* type — same address)
printf("%d", *ip);   // 5     (value at ip → 5)
printf("%d", *&a);   // 5     (dereference of address of a)

Pointer with char
cchar c;
c = 'A';
char *cp;
cp = &c;

printf("%c", c);      // A    (char)
printf("%d", cp);     // 500  (address of char)
printf("%d", &c);     // 500  (char* address)
printf("%d", *cp);    // 65   (ASCII of 'A')
printf("%d", *&c);    // 65

Pointer with float
cfloat f;
f = 3.125f;
float *fp;
fp = &f;

printf("%f", f);        // 3.12
printf("%d", fp);       // 700 (address)
printf("%d", *fp);      // (value as int — garbage interpretation)
printf("%.f", fp+1);    // 3.1 (float pointer arithmetic)

Complete Mixed Example
cint a = 6;
char c = 'n';
float f = 3.125f;
int *ip = &a;       // integer pointer
char *cp = &c;      // integer pointer (char type)
float *fp = &f;     // integer pointer (float type)

printf("%d %d %d\n%s", ip, &a, ip+1);
printf("%c %d %d\n", *cp, &c, cp+1);
printf("%.f %d %d\n", *fp, &f, fp+1);

In the above example: a is a variable of int type. int type variables are used to store integer type data. ip is a variable of int* type. int* type variables are used to store integer addresses.


Two Pointer Variables
cint a, b;
int *p1, *p2;
a = 10; b = 20;
p1 = &a; p2 = &b;
*p1 = 30;     // a becomes 30
p1 = p2;      // p1 now points to b
*p2 = 40;     // b becomes 40
printf("%d %d\n", a, b);    // 30  40
printf("%d %d\n", *p1, *p2); // 40  40

Pointer Increment in int
cint a = 10;
int *ip = &a;       // ip = 500 (say)
++*ip;              // value at ip becomes 11
++ip;               // ip = 502 (moved to next int)
// In the above program, if we replace int pointer:
// one time increment → only address will be replaced

8. sizeof() with Pointers
cchar *cp;
float *fp;

// sizeof pointer depends on the compiler/architecture
// In online compiler: sizeof(ip) = sizeof(fp) = 8 bytes
// In Turbo C:         sizeof = 6 bytes
// The pointer will not depend on data type
// it depends on address lines of the system

sizeof(ip);   // 8 (64-bit system) or 4 (32-bit) or 2 (16-bit)
sizeof(fp);   // same as above

// Turbo C: always 8 bytes for any pointer type
// Online compiler: always 8 bytes for any pointer type

Key Rule: sizeof a pointer is always the same regardless of data type. It depends on the address lines (architecture).


Example with Output
cint a, b;
int *p1, *p2;
a = 10; b = 80;
p1 = &a; p2 = &b;

++*p1;          // a = 11
++*p1;          // a = 12
printf("%d %d %d %d\n", a, b, *p1, *p2);
// O/P: 12  80  12  80

printf("%d %d %d %d\n", a, b, *p1, *(p2));
// Same output

printf("%d %d %d %d\n", a, b, *(p1), *p2);
// Same
