// Algorithm:
// 1. Sort array and return 2nd element from last
// OR
int secondMax(int* p, int h) {
  int first_max = p[0], second_max = p[0];
  for (int i = 1; i < h; i++) {
    if (p[i] > first_max) {
      second_max = first_max;
      first_max  = p[i];
    }
  }
  return second_max;
}
