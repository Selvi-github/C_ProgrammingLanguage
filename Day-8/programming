⑭ Sign of product of array
int arraySign(int* nums, int numsSize) {
  int prod = 1;
  for (int i=0; i<numsSize; i++)
    prod *= nums[i];
  if (prod > 0) return 1;
  else if (prod < 0) return -1;
  else return 0;
}
⑮ Running sum of 1D array
int* runningSum(int* nums, int numsSize,
                  int* returnSize) {
  int sum = 0;
  *returnSize = numsSize;
  for (int i=1; i<numsSize; i++)
    nums[i] += nums[i-1];
  return nums;
}
Each element becomes sum of itself + all previous elements.
