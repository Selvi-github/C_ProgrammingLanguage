⑰ Difference between element sum & digit sum
int ele_sum = 0;
int digit_sum = 0;
for (int i=0; i<numsSize; i++) {
  ele_sum += nums[i];
  int a = nums[i];
  while (a != 0) {
    int rem = a % 10;
    digit_sum += rem;
    a = a / 10;
  }
}
return ele_sum - digit_sum;
